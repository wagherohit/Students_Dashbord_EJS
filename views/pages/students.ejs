<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Student List</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f9f9f9;
      padding: 20px;
      margin: 0;
      background:linear-gradient(135deg, #6a11cb, #2575fc); 
      color:white;
    }
    h1 {
      text-align: center;
      color: #333;
      margin-top: 100px; /* 👈 Push content below navbar */
    }
    table {
      width: 60%;
      margin: 20px auto;
      border-collapse: collapse;
      background: white;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    th, td {
      padding: 12px 16px;
      border: 1px solid #ddd;
      text-align: center;
    }
    th {
      background: #2575fc;
      color: white;
    }
    tr {
      color: #333;
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>

  <h1>Student List 📚</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Roll.No</th>
        <th>Course</th>
        <th>Batch</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(student => { %>
        <tr>
          <td><%= student.name %></td>
          <td><%= student.rollNo %></td>
          <td><%= student.course %></td>
          <td><%= student.batch %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

      <%- include('../partials/footer') %>

</body>
</html>
